{
  "name": "sicons",
  "version": "0.3.0",
  "description": "React icon components in Bold, Outline, Bulk, and Broken styles (3,853 icons)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:components && npm run build:lib",
    "build:components": "node scripts/generate-components.js",
    "build:lib": "rollup -c",
    "dev": "rollup -c -w",
    "prepare": "npm run build"
  },
  "keywords": [
    "react",
    "icons",
    "components",
    "svg",
    "design-system",
    "ui",
    "outline-icons",
    "bold-icons",
    "bulk-icons",
    "broken-icons",
    "iconsax",
    "vuesax"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^18.2.48",
    "react": "^18.2.0",
    "rollup": "^4.9.6",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesiddart/sicons.git"
  },
  "homepage": "https://github.com/thesiddart/sicons#readme",
  "bugs": {
    "url": "https://github.com/thesiddart/sicons/issues"
  }
}
